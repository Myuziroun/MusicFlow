{
  "name": "music-listener-downloader",
  "private": true,
  "version": "1.0.0",
  "description": "MusicFlow - Offline Music Player & Downloader",
  "author": "MusicFlow",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "electron:dev": "concurrently -k \"vite\" \"electron . --dev\"",
    "electron:build": "npm run build && electron-builder --config electron-builder.json --win",
    "cap:build": "npm run build && cap sync android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "browser-id3-writer": "^4.4.0",
    "cors": "^2.8.5",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "music-metadata-browser": "^2.5.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
